<section id="services" class="py-24">
  <div class="mx-auto w-full max-w-6xl px-6 text-center">
    <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">Our Services</h2>
    <p class="mt-4 text-muted-foreground">Everything you need from design to deployment.</p>
    <div class="mt-16 grid grid-cols-1 gap-8 md:grid-cols-3 text-left">
      <div class="rounded-2xl bg-card border border-border/50 p-8 shadow-sm">
        <h3 class="text-xl font-bold">Frontend Engineering</h3>
        <p class="mt-4 text-sm leading-relaxed text-muted-foreground">Expert pixel-perfect implementation using React, Astro, Next.js with deep attention to interactive animations and smooth UI logic.</p>
      </div>
      <div class="rounded-2xl bg-card border border-border/50 p-8 shadow-sm">
        <h3 class="text-xl font-bold">Brand Design</h3>
        <p class="mt-4 text-sm leading-relaxed text-muted-foreground">We formulate Anthropic-inspired aesthetic guidelines, curating typography, spacing, and Oklch color profiles.</p>
      </div>
      <div class="rounded-2xl bg-card border border-border/50 p-8 shadow-sm">
        <h3 class="text-xl font-bold">Fullstack Infrastructure</h3>
        <p class="mt-4 text-sm leading-relaxed text-muted-foreground">Robust deployment, backend design, and enterprise-grade architecture for tools that must run smoothly at scale.</p>
      </div>
    </div>
  </div>
</section>
