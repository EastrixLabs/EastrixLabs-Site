---
import { Mail } from "lucide-react";
---
<section id="contact" class="mx-auto w-full max-w-6xl px-6 py-24 text-center">
  <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">Ready to elevate your game?</h2>
  <p class="mt-4 text-muted-foreground max-w-xl mx-auto">
    Whether you are scaling a product or starting fresh, our team is equipped to deliver butter-smooth software. Contact us today.
  </p>
  
  <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2 text-left">
    <div class="rounded-2xl border border-border/50 bg-card p-8 shadow-sm">
      <h3 class="text-lg font-bold flex items-center gap-2"><Mail size={18}/> Direct Email</h3>
      <p class="mt-2 text-sm text-muted-foreground">Contact us directly anytime.</p>
      <a href="mailto:eastrixlabs@gmail.com" class="mt-6 inline-flex h-10 items-center justify-center rounded-lg bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90 w-full sm:w-auto">
        eastrixlabs@gmail.com
      </a>
    </div>
    <div class="rounded-2xl border border-border/50 bg-card p-8 shadow-sm">
      <h3 class="text-lg font-bold">Live Support</h3>
      <p class="mt-2 text-sm text-muted-foreground mb-6">Available Mon-Fri, 9am - 5pm PHT. We'll respond to your email within 24 hours.</p>
      <p class="text-sm font-medium text-foreground">Eastrix Labs Headquarters</p>
    </div>
  </div>
</section>
